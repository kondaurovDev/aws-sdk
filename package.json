{
  "name": "aws-sdk-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -F @effect-ak/aws-sdk run build",
    "generate": "pnpm -F demo run generate",
    "check": "tsc -p scripts && pnpm -r --if-present run check",
    "test": "pnpm -r --if-present run test",
    "ci": "pnpm run build && pnpm run generate && pnpm run check && pnpm run test",
    "probe": "node scripts/probe-all-clients.ts",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm run build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "catalog:tooling",
    "@types/node": "catalog:tooling",
    "typescript": "catalog:tooling"
  },
  "packageManager": "pnpm@12.3.4"
}
