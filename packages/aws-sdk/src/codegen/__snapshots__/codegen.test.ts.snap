  readonly message: string
  readonly waiter: AcmeWaiter
  /** \`TIMEOUT\` after \`maxWaitTime\`; \`FAILURE\` when a state the waiter cannot recover from was observed */
  readonly state: "TIMEOUT" | "FAILURE"
